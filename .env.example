# ============================================================
# Invictus Solar — variáveis de ambiente (monorepo)
# ------------------------------------------------------------
# Copie este arquivo e distribua os blocos:
#   apps/web/.env          (somente chaves NEXT_PUBLIC_*)
#   apps/api/.env          (bloco Backend API)
#   apps/celesc-monitor/.env  (bloco Celesc Monitor)
# ============================================================

# ------------------------------------------------------------
# Frontend (apps/web/.env)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
NEXT_PUBLIC_API_URL=http://localhost:8000

# Contatos de suporte exibidos no portal do cliente (opcionais; se vazios, card some)
# WhatsApp no formato internacional só com dígitos (ex: 5548999999999)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=

# ------------------------------------------------------------
# Backend API — FastAPI (apps/api/.env)
# ------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon
# Settings → API → JWT Settings → JWT Secret (HS256)
SUPABASE_JWT_SECRET=

# WhatsApp (Evolution API por padrão; trocar base_url p/ Z-API se preferir)
WHATSAPP_BASE_URL=https://sua-evolution-api.com
WHATSAPP_INSTANCE=invictus
WHATSAPP_TOKEN=xxxxxxxx

# Web Push VAPID — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@invictussolar.com.br

# URL pública do portal (usada nos links enviados por WhatsApp/push)
PORTAL_BASE_URL=http://localhost:3000
# Origens permitidas no CORS (CSV). Em produção: apenas o domínio do PWA.
ALLOWED_ORIGINS=http://localhost:3000

# Segredo pro endpoint /cron/maintenance-check — mande no header X-Cron-Secret
CRON_SECRET=

# Sentry (opcional — se vazio, não inicializa)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------
# Celesc Monitor (apps/celesc-monitor/.env)
# ------------------------------------------------------------
CELESC_USER=email
CELESC_PASSWORD=sua_senha

# Webhook n8n para notificações de mudança de status
WEBHOOK_URL=https://n8nwebh.otear.com.br/webhook/status-celesc

# Caminhos de dados (ajustar para Docker)
ARQUIVO_HISTORICO=/app/data/dados_anteriores.json
COOKIES_PATH=/app/data/celesc_cookies.json
