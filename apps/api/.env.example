SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon
# Settings → API → JWT Settings → JWT Secret (HS256)
SUPABASE_JWT_SECRET=

# WhatsApp via n8n webhook — recebe {phone, message} e dispara internamente
WHATSAPP_WEBHOOK_URL=https://n8nwebh.otear.com.br/webhook/envio-app
# Opcional: chave secreta enviada no header X-Webhook-Secret (use se o n8n validar)
WHATSAPP_WEBHOOK_SECRET=

# Web Push VAPID — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@invictussolar.com.br

PORTAL_BASE_URL=http://localhost:3000
# Origens permitidas (CSV). Em produção, apenas o domínio do PWA.
ALLOWED_ORIGINS=http://localhost:3000

# Header X-Cron-Secret exigido em /cron/*
CRON_SECRET=
# Header X-Celesc-Secret exigido em /celesc/*  (se vazio, cai pra CRON_SECRET)
CELESC_SECRET=
